{
  "name": "ajar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "dev:classic": "VITE_PALETTE=aalto-classic slidev --open",
    "dev:scicomp-web": "VITE_PALETTE=scicomp-web slidev --open",
    "pdf": "slidev export --with-toc --output public/Glerean_2026_OpenClosed.pdf",
    "dev:compact": "slidev slides-compact.md --open",
    "build:compact": "slidev build slides-compact.md",
    "pdf:compact": "slidev export slides-compact.md --with-toc --output public/Glerean_2026_OpenClosed_compact.pdf"
  },
  "dependencies": {
    "@slidev/cli": "~0.47.5"
  }
}
